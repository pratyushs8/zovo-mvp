# ─── App environment ──────────────────────────────────────────────────────────
# NODE_ENV is set by Next.js automatically (development / production).
# APP_ENV lets you distinguish staging from production at runtime.
# Values: local | staging | production
APP_ENV=local

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string used by Drizzle ORM.
# Local:   postgresql://user:password@localhost:5432/zoco
# Staging: injected by host (e.g. Railway, Neon, Supabase)
# Prod:    injected by host — never put real creds here
DATABASE_URL=postgresql://user:password@localhost:5432/zoco

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# API key for the OpenAI Responses API.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
